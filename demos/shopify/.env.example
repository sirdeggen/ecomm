BSV_NETWORK=testnet
PAYMENT_SERVER_URL=http://127.0.0.1:4000
NEXT_PUBLIC_PAYMENT_SERVER_URL=http://127.0.0.1:4000
ALLOW_SIMULATED_PAYMENTS=true
# Dev Dashboard client id and secret. The plugin mints a 24-hour Admin API token from these.
SHOPIFY_SHOP=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional static Admin API token. The helper sends this value for the life of the process.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_URL=http://127.0.0.1:4100/
SHOPIFY_RECEIVER_PORT=4100
WEBHOOK_SECRET=change-me
