# Shared payment server. Copy to packages/payment-server/.env or export these before `npm run start:server`.
# Default network is testnet. Do not point this at mainnet unless you mean to.

BSV_NETWORK=testnet
# Account-level extended public key. Invoices derive m/0/{index}. Leave empty to generate a testnet key in DATA_DIR.
BSV_XPUB=
# Optional handle shown as a paymail fallback. Detection still watches the unique invoice address.
BSV_PAYMAIL=
BSV_QUOTE_TTL_SECONDS=900
# Set to skip the live WhatsOnChain rate (USD per 1 BSV). Leave empty in normal use.
BSV_STATIC_USD_RATE=
ARC_URL=https://arc-test.taal.com
# Public testnet ARC returns 401 without a key. WhatsOnChain still verifies the transaction.
ARC_API_KEY=
PORT=4000
PAYMENT_SERVER_PUBLIC_URL=http://127.0.0.1:4000
WEBHOOK_SECRET=change-me
# Used when an invoice does not pass its own webhookUrl.
WEBHOOK_URL=
# Dev only. The shopper must also tick "Simulated payment" and confirm. Production must be false.
ALLOW_SIMULATED_PAYMENTS=true
DATA_DIR=./data
# Non-USD invoices are converted with this public FX API (Frankfurter / ECB).
FX_URL=https://api.frankfurter.app
# Optional path to the browser checkout bundle. Defaults to packages/checkout-ui/dist/checkout.js.
CHECKOUT_BUNDLE=
