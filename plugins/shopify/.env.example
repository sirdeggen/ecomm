# A Shopify Partner account creates the dev store and the custom app.
# One app installation is one store. Payments Apps access is controlled by Shopify;
# this plugin does not use that program.
BSV_NETWORK=testnet
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_URL=http://127.0.0.1:4100/
SHOPIFY_RECEIVER_PORT=4100
PAYMENT_SERVER_URL=http://127.0.0.1:4000
WEBHOOK_SECRET=change-me
