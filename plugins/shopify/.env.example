# A Dev Dashboard app is installed on one dev store. Payments Apps access is controlled
# by Shopify; this plugin does not use that program.
# SHOPIFY_API_KEY is the client id and SHOPIFY_API_SECRET is the client secret.
# The receiver and the seed script exchange them for an Admin API token
# (POST /admin/oauth/access_token, grant_type=client_credentials). The token expires
# in about 24 hours. The process caches it in memory, refreshes it one minute before
# expiry, and refreshes once more if Shopify answers 401.
# SHOPIFY_ADMIN_TOKEN is optional. Set it to send that static token for the life of the process.
BSV_NETWORK=testnet
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-10
SHOPIFY_WEBHOOK_URL=http://127.0.0.1:4100/
SHOPIFY_RECEIVER_PORT=4100
PAYMENT_SERVER_URL=http://127.0.0.1:4000
WEBHOOK_SECRET=change-me
