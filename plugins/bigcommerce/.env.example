# A Technology Partner account is required for a BigCommerce sandbox store.
# This plugin does not add a card gateway. It updates an order that used an offline method.
BSV_NETWORK=testnet
BIGCOMMERCE_STORE_HASH=
BIGCOMMERCE_ACCESS_TOKEN=
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=
# Confirm on the store with GET /v2/order_statuses. 11 is the stock Awaiting Fulfillment id.
BIGCOMMERCE_PAID_STATUS_ID=11
BIGCOMMERCE_WEBHOOK_URL=http://127.0.0.1:4101/
BIGCOMMERCE_RECEIVER_PORT=4101
PAYMENT_SERVER_URL=http://127.0.0.1:4000
WEBHOOK_SECRET=change-me
