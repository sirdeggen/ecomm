# Read by the gateway from the environment. WordPress does not load .env by itself;
# export these, or set them in the container as the demo compose file does.
BSV_NETWORK=testnet
BSV_PAY_SERVER_URL=http://127.0.0.1:4000
# Browser-facing URL when PHP runs in Docker and the server URL is only reachable inside the network.
BSV_PAY_PUBLIC_URL=http://127.0.0.1:4000
WEBHOOK_SECRET=change-me
# Optional. The demo compose file sets the database; not read by the gateway.
WORDPRESS_DB_HOST=db
WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=wordpress
